# OpenAI-compatible Chat Completions endpoint; model must support function tools.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=

# Optional multi-provider routing: copy models.config.example.json to models.config.json.
# Set keys only for profiles you want to use; edit model IDs for your account.
DEEPSEEK_API_KEY=
ZHIPU_API_KEY=
CUSTOM_API_KEY=
# CODEGEIST_MODELS_FILE=models.config.json

# Optional semantic evaluator. If absent, live runs display a transparent fallback.
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai/v1
TYPESAFE_MODEL=jev-1.13.0

# Listen on the LAN by default. Set HOST=127.0.0.1 for access from this machine only.
HOST=0.0.0.0
PORT=4317
# CODEGEIST_DATA_DIR=.codegeist
